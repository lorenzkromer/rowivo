    "Your profile, plan, history, notes, PM5 recordings, active session, saved credentials and local recovery copies will be deleted. Cloud connections will be removed. Files you already exported stay in your storage. This cannot be undone." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Profil, Plan, Verlauf, Notizen, PM5-Aufzeichnungen, die laufende Einheit, gespeicherte Zugangsdaten und lokale Wiederherstellungskopien werden gelöscht. Cloud-Verknüpfungen werden entfernt. Bereits exportierte Dateien bleiben in deinem Speicher. Das lässt sich nicht rückgängig machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your profile, plan, history, notes, PM5 recordings, active session, saved credentials and local recovery copies will be deleted. Cloud connections will be removed. Files you already exported stay in your storage. This cannot be undone."
          }
        }
      }
    },
    "Your profile, plan, history, notes, device recordings, active session, saved credentials and local recovery copies will be deleted. Cloud connections will be removed. Files you already exported stay in your storage. This cannot be undone." : {
