    "Pause after 6 seconds below the threshold; resume after 2 seconds at least 4 W above it. Planned rests continue normally. Manual pauses stay paused. Requires live power readings." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach 6 Sekunden unter dem Grenzwert pausieren; nach 2 Sekunden mit mindestens 4 W darüber fortsetzen. Geplante Erholungsphasen laufen weiter. Manuelle Pausen bleiben bestehen. Erfordert aktuelle Watt-Messwerte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pause after 6 seconds below the threshold; resume after 2 seconds at least 4 W above it. Planned rests continue normally. Manual pauses stay paused. Requires live power readings."
          }
        }
      }
    },
