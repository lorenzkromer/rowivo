    "%lld/5" : {
      "comment" : "A button that sets the effort rating of a workout.",
      "isCommentAutoGenerated" : true
    },
    "/500 m" : {
      "comment" : "A label displayed alongside the pace of a workout.",
      "isCommentAutoGenerated" : true
    },
    "0" : {
      "comment" : "A label that displays a text field for entering the number of minutes.",
      "isCommentAutoGenerated" : true
    },
    "1" : {
      "comment" : "A label that describes the rest period between each repetition.",
      "isCommentAutoGenerated" : true
    },
    "1. Enable Bluetooth pairing on your rower. On a PM5, open Connect. Disconnect other training apps if needed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Aktiviere die Bluetooth-Verbindung am Rudergerät. Beim PM5 öffnest du „Verbinden“. Trenne bei Bedarf andere Trainings-Apps."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Enable Bluetooth pairing on your rower. On a PM5, open Connect. Disconnect other training apps if needed."
          }
        }
      }
    },
    "1. On your PM5, open Connect. If needed, disconnect another app first." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Öffne am PM5 „Verbinden“. Trenne bei Bedarf zuerst die Verbindung zu einer anderen App."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. On your PM5, open Connect. If needed, disconnect another app first."
          }
        }
      }
    },
    "2" : {
      "comment" : "A label that describes the number of minutes to row.",
      "isCommentAutoGenerated" : true
    },
    "2. Find your PM5 below and select its name. The number matches your monitor." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Suche unten deinen PM5 und wähle seinen Namen. Die Nummer stimmt mit deinem Monitor überein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Find your PM5 below and select its name. The number matches your monitor."
          }
        }
      }
    },
    "2. Search below and select your device. FTMS devices are checked for rowing support when connecting." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Suche unten und wähle dein Gerät. Bei FTMS-Geräten wird beim Verbinden geprüft, ob sie Ruderdaten senden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Search below and select your device. FTMS devices are checked for rowing support when connecting."
          }
        }
      }
    },
    "3. Choose free rowing on your device (Just Row on PM5), start your Rowivo session, then begin rowing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Wähle freies Rudern am Gerät („Einfach Rudern“ beim PM5), starte die Einheit in Rowivo und rudere los."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Choose free rowing on your device (Just Row on PM5), start your Rowivo session, then begin rowing."
          }
        }
      }
    },
    "3. Select Just Row on the PM5, start your session in Rowivo, then begin rowing." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Wähle am PM5 „Einfach rudern“, starte die Einheit in Rowivo und rudere los."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Select Just Row on the PM5, start your session in Rowivo, then begin rowing."
          }
        }
      }
    },
    "A change to consider" : {
      "extractionState" : "manual",
      "localizations" : {
