    "NSBluetoothAlwaysUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rowivo verbindet sich per Bluetooth mit kompatiblen Rudergeräten, um deine Messwerte anzuzeigen und dein Training aufzuzeichnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rowivo connects to compatible rowing machines via Bluetooth to display and record your workout."
          }
        }
      }
    },
    "Rowivo Training Backup": {},
    "NSHealthUpdateUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rowivo keeps your rowing workout active on Apple Watch and saves it to Apple Health when you save your session."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rowivo hält dein Rudertraining auf der Apple Watch aktiv und speichert es in Apple Health, wenn du deine Einheit speicherst."
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "extractionState": "manual",
      "localizations": {
